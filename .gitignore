# ==========================================================
#  agnes-image-mcp — Git 忽略規則
#  原則：相依套件、金鑰、個人設定、工作流產出物 一律不進版控
# ==========================================================

# ----------------------------------------------------------
# 1. 機密資料（最重要）
#    API Key 只能放在系統環境變數，絕不可提交
# ----------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.p12

# 若日後產生效密設定副本，也一併排除
opencode.local.json
opencode.local.jsonc
.env.local

# ----------------------------------------------------------
# 2. 相依套件（npm install 產生）
# ----------------------------------------------------------
node_modules/
jspm_packages/
web_modules/

# 套件管理器暫存
.npm/
.yarn/
.yarn-integrity
.pnpm-store/
bun.lockb

# ----------------------------------------------------------
# 3. 產出物 / 快取
# ----------------------------------------------------------
# MCP 除錯報告
/debug-report/
*.debug-report.md

# 日誌
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 快取
.cache/
.temp/
.tmp/
*.tsbuildinfo

# ----------------------------------------------------------
# 4. 電商圖片工作流產出
#    生成的圖檔體積大且可重新產生，不建議進版控
#    若想保留產出歷程，刪除以下幾行即可
# ----------------------------------------------------------
/output/
/products/*/output/
/products/*/generated/
/products/*/final/
/reference/generated/

# 保留規劃文件（這些是重要的工作流產出，刻意不忽略）
# products/*/planning/*.md

# ----------------------------------------------------------
# 5. 本機參考圖（視專案情況）
#    參考圖通常含客戶素材，預設不提交
# ----------------------------------------------------------
# /reference/

# ----------------------------------------------------------
# 6. 編輯器 / IDE
# ----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp
*.swo
*~
.history/
*.sublime-workspace
*.sublime-project

# ----------------------------------------------------------
# 7. 作業系統產生的檔案
# ----------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ----------------------------------------------------------
# 8. 其他
# ----------------------------------------------------------
*.zip
*.7z
*.rar
